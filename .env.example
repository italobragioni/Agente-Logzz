# ==========================================================================
# WhatsAgent COD — Variáveis de Ambiente
# --------------------------------------------------------------------------
# Copie este arquivo para ".env.local" (no seu computador) OU cadastre cada
# variável no painel da Vercel (Settings > Environment Variables).
# NUNCA envie o arquivo .env.local para o GitHub. Ele já está no .gitignore.
# ==========================================================================

# --- Supabase (encontrado em Project Settings > API) ----------------------
# URL do projeto. Exemplo: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon" (pode ir para o navegador, é segura)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta "service_role" (NUNCA vai para o navegador — apenas servidor)
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (encontrado em https://platform.openai.com/api-keys) ----------
OPENAI_API_KEY=
# Modelo usado pelo agente. Recomendado: gpt-4o-mini (barato e bom)
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp Cloud API (painel developers.facebook.com) ------------------
# Token de acesso (Bearer). Comece com o token temporário, depois gere um permanente.
META_WHATSAPP_ACCESS_TOKEN=
# ID do número de telefone (Phone Number ID)
META_WHATSAPP_PHONE_NUMBER_ID=
# ID da conta comercial do WhatsApp (WhatsApp Business Account ID)
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token de verificação que VOCÊ inventa. Use algo difícil, ex: minha-chave-secreta-123
META_WHATSAPP_VERIFY_TOKEN=

# --- Aplicação ------------------------------------------------------------
# URL pública do site. Em produção: https://seu-projeto.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
